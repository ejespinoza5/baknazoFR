# URL de la API (sin barra al final).
VITE_API_URL=https://apibaknzo.duckdns.org

# ---------- Firebase Cloud Messaging (notificaciones push) ----------
# Consola de Firebase → Configuración del proyecto → General → "Tus apps" → app web.
# Estos valores identifican el proyecto y viajan en el navegador: no son secretos.
# Sin ellos la app funciona igual; solo no se ofrece activar el push.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Configuración del proyecto → Cloud Messaging → Certificados push web → par de claves (la pública).
VITE_FIREBASE_VAPID_KEY=
